DATABASE_URL=postgresql+psycopg://marketplace:marketplace@127.0.0.1:5432/marketplace
ENABLE_DEMO_SEED=1
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
# Payment provider: mock (default) or solana
PAYMENT_PROVIDER=mock
# SOLANA_RPC_URL=http://127.0.0.1:8899
# SOLANA_PROGRAM_ID=9ZZ5bejD4NdPr7zf9covKHDig6tcqh628Fdtrm4mT9MU
# SOLANA_AUTHORITY_KEYPAIR=/path/to/authority.json
# On Vercel use the secret instead of a file: the JSON array from the keypair file
# SOLANA_AUTHORITY_KEYPAIR_JSON=[12,34,...]
